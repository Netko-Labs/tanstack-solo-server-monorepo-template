/** The signed-in user's id from a router context, without depending on its type. */
export function userIdOf(ctx: unknown): string | undefined {
  if (typeof ctx !== 'object' || ctx === null || !('user' in ctx)) return undefined
  const { user } = ctx
  if (typeof user !== 'object' || user === null || !('id' in user)) return undefined
  return typeof user.id === 'string' ? user.id : undefined
}
