import type { ErrorScope } from '@temp-repo/observability'
import type { TRPCError, TRPCProcedureType } from '@trpc/server'

export type ErrorTransport = 'http' | 'ws'

export type ErrorReporter = (error: unknown, scope: ErrorScope) => void

/** The fields of a tRPC error event the reporter reads, for any router. */
export interface ReportableFailure {
  error: TRPCError
  path: string | undefined
  type: TRPCProcedureType | 'unknown'
  ctx: unknown
}
