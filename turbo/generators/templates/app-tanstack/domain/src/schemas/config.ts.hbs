import { z } from 'zod'

export const {{ pascalCase name }}ConfigSchema = z.object({
  app: z.object({
    dev: z.boolean(),
    baseUrl: z.string().url(),
    port: z.number().int().positive(),
  }),
  cache: z.object({
    url: z.string(),
  }),
  db: z.object({
    url: z.string(),
  }),
  observability: z.object({
    serviceName: z.string().min(1),
    release: z.string().min(1),
    environment: z.string().min(1),
    dsn: z.string().url().optional(),
    tunnelDsns: z.array(z.string()).default([]),
    otlp: z
      .object({ endpoint: z.string().url(), headers: z.record(z.string(), z.string()) })
      .optional(),
  }),
  auth: z.object({
    trustedOrigins: z.array(z.string()).default([]),
  }),
})

export type {{ pascalCase name }}Config = z.infer<typeof {{ pascalCase name }}ConfigSchema>
