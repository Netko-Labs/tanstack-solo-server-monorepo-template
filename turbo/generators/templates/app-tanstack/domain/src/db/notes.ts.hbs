import { pgTable, text, timestamp, uuid } from 'drizzle-orm/pg-core'

export const noteTable = pgTable('note', {
  id: uuid('id')
    .primaryKey()
    .$defaultFn(() => crypto.randomUUID()),
  body: text('body').notNull(),
  createdAt: timestamp('created_at')
    .$defaultFn(() => new Date())
    .notNull(),
})
