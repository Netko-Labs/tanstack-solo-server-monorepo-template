{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "build": {
      "commands": ["bun run repo build --app {{ name }}"]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      { "step": "build", "include": ["apps/{{ name }}/.output"] }
    ],
    "aptPackages": ["curl"],
    "variables": { "CI": "", "SERVER_SHUTDOWN_TIMEOUT": "10" },
    "startCommand": "bun apps/{{ name }}/.output/migrate/migrate.js && bun apps/{{ name }}/.output/server/index.mjs"
  }
}
