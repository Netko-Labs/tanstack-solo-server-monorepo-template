# Every variable {{ name }} reads. Copy to .env; the defaults match compose.yml.
# Production refuses to boot without BASE_URL and DATABASE_URL.

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
# NODE_ENV is set for you: vite dev → development; repo build and the start script → production.
# Pino level; default debug in development, info in production. Tests accept silent.
# LOG_LEVEL=info
# No auth is scaffolded; port it from apps/studio when needed (AUTH_SECRET comes with it).

# ── Data ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/{{ name }}
CACHE_URL=redis://localhost:6380
# Host ports for compose.yml's Postgres and Redis; change together with DATABASE_URL / CACHE_URL.
# {{ constantCase name }}_DB_PORT=5433
# {{ constantCase name }}_REDIS_PORT=6380

# ── Edge ─────────────────────────────────────────────────────────────────────
# Extra browser origins trusted on /api/trpc and the /trpc-ws upgrade (BASE_URL is always trusted)
TRUSTED_ORIGINS=

# ── Observability → code-whiskers (all optional; unset = off; docs/observability.md) ──
# The browser bundle bakes in VITE_SENTRY_DSN plus the release and environment at build time.
# SENTRY_DSN=https://<public_key>@whiskers.example.com/<projectId>
# VITE_SENTRY_DSN=https://<public_key>@whiskers.example.com/<projectId>
# OTEL_EXPORTER_OTLP_ENDPOINT=https://whiskers.example.com/otlp
# OTEL_EXPORTER_OTLP_HEADERS=x-codewhiskers-key=<public_key>
# OTEL_SERVICE_NAME={{ name }}
# Default: production when NODE_ENV=production, else development. Staging must set it.
# SENTRY_ENVIRONMENT=staging
# Default: SOURCE_COMMIT (Coolify sets it), else dev.
# SENTRY_RELEASE=
