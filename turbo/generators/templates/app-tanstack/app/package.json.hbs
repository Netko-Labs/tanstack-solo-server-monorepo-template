{
  "name": "{{ name }}-app",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsgo --noEmit",
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "NODE_ENV=production bun .output/server/index.mjs",
    "docker:up": "repo docker:up --app {{ name }}",
    "docker:down": "repo docker:down --app {{ name }}",
    "db:migrate": "repo db:migrate --app {{ name }}",
    "db:generate": "repo db:generate --app {{ name }}",
    "db:push": "repo db:push --app {{ name }}",
    "db:seed": "repo db:seed --app {{ name }}"
  },
  "dependencies": {
    "@temp-repo/logger": "workspace:*",
    "@temp-repo/{{ name }}-config": "workspace:*",
    "@temp-repo/{{ name }}-domain": "workspace:*",
    "@temp-repo/{{ name }}-repository": "workspace:*",
    "@temp-repo/{{ name }}-service": "workspace:*",
    "@temp-repo/{{ name }}-trpc": "workspace:*",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.59",
    "@trpc/tanstack-react-query": "^11.19.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "@types/bun": "^1.4.2"
  }
}
