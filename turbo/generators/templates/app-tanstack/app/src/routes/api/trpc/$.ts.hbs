import { createFileRoute } from '@tanstack/react-router'
import { createLogger } from '@temp-repo/logger'
import { {{ camelCase name }}EnvConfig } from '@temp-repo/{{ name }}-config'
import {
  appRouter,
  createContext,
  createTRPCHttpHandler,
  reportInternalErrors,
} from '@temp-repo/{{ name }}-trpc'

const handle = createTRPCHttpHandler({
  router: appRouter,
  endpoint: '/api/trpc',
  createContext,
  trustedOrigins: [{{ camelCase name }}EnvConfig.app.baseUrl, ...{{ camelCase name }}EnvConfig.auth.trustedOrigins],
  logger: createLogger('trpc-http'),
  onError: reportInternalErrors('http'),
})

export const Route = createFileRoute('/api/trpc/$')({
  server: {
    handlers: {
      GET: ({ request }) => handle(request),
      POST: ({ request }) => handle(request),
    },
  },
})
