import { afterEach, describe, expect, mock, spyOn, test } from 'bun:test'
import { {{ pascalCase name }}ApiError } from './errors'
import { create{{ pascalCase name }}Client } from './{{ name }}-client'
import { {{ constantCase name }}_API_VERSION } from './values'

const config = { baseUrl: 'https://api.example.test/', apiKey: 'test-key' }

describe('create{{ pascalCase name }}Client', () => {
  afterEach(() => {
    mock.restore()
  })

  test('calls the versioned endpoint with bearer auth and a timeout', async () => {
    const fetchSpy = spyOn(globalThis, 'fetch').mockResolvedValue(new Response(null, { status: 204 }))

    await create{{ pascalCase name }}Client(config).ping()

    const [url, init] = fetchSpy.mock.calls[0] ?? []
    expect(String(url)).toBe(`https://api.example.test/${ {{~ constantCase name ~}}_API_VERSION}/ping`)
    expect(new Headers(init?.headers).get('authorization')).toBe('Bearer test-key')
    expect(init?.signal).toBeInstanceOf(AbortSignal)
  })

  test('a non-2xx response throws {{ pascalCase name }}ApiError with status and detail', async () => {
    spyOn(globalThis, 'fetch').mockResolvedValue(new Response('nope', { status: 401 }))

    const error = await create{{ pascalCase name }}Client(config)
      .ping()
      .catch((caught: unknown) => caught)

    expect(error).toBeInstanceOf({{ pascalCase name }}ApiError)
    expect(error).toMatchObject({ status: 401, detail: 'nope' })
  })
})
