{
  "name": "start-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:setup && bun run dev:serve",
    "dev:serve": "NODE_ENV=development bun run server.ts",
    "start": "bun run server.ts",
    "build": "NODE_ENV=production bunx --bun vite build",
    "prod:release": "NODE_ENV=production bun run prod:setup && bun run start",
    "prod:setup": "bun run db:generate && bun run db:deploy",
    "dev:setup": "bun run db:generate && bun run db:migrate",
    "db:migrate": "bun run --env-file=../../../apps/web/.env --cwd ../../packages/web/repository db:migrate",
    "db:generate": "bun run --filter @temp-repo/web-repository db:generate",
    "db:deploy": "bun run --filter @temp-repo/web-repository db:deploy"
  },
  "dependencies": {
    "@temp-repo/logger": "workspace:*",
    "@temp-repo/web-config": "workspace:*",
    "@temp-repo/web-domain": "workspace:*",
    "@temp-repo/web-repository": "workspace:*",
    "@temp-repo/web-service": "workspace:*",
    "@temp-repo/web-trpc": "workspace:*",
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@trpc/tanstack-react-query": "^11.1.2",
    "class-variance-authority": "^0.7.1",
    "fetch-to-node": "^2.1.0",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.4.3",
    "superjson": "^2.2.2",
    "trpc-bun-adapter": "^1.3.0",
    "shadcn": "^3.6.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0",
    "@types/bun": "^1.3.4"
  }
}
