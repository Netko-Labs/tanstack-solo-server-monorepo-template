{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "build": {
      "deployOutputs": [],
      "commands": ["bun run repo build --app studio"]
    }
  },
  "deploy": {
    "paths": ["/mise/installs/bun/latest/bin"],
    "inputs": [
      {
        "step": "packages:mise",
        "include": ["/mise/installs/bun"]
      },
      { "step": "build", "include": ["apps/studio/.output"] }
    ],
    "startCommand": "bun apps/studio/.output/server/index.mjs"
  }
}
