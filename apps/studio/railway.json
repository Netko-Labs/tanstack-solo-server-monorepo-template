{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/apps/studio/**",
      "/packages/studio/**",
      "/packages/configs/studio-config/**",
      "/packages/shared/**",
      "/package.json",
      "/bun.lock"
    ]
  },
  "deploy": {
    "preDeployCommand": ["bun apps/studio/.output/migrate/migrate.js"],
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
