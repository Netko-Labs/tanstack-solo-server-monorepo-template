AUTH_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/temp-repo
# Set → RoomBus fans out over Redis pub/sub (multi-instance). Empty → in-process bus.
CACHE_URL=redis://localhost:6379
# Extra browser origins trusted by better-auth and the /trpc-ws upgrade (BASE_URL is always trusted)
TRUSTED_ORIGINS=

# Optional OAuth providers (magic link is always on)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: production email delivery for magic links (falls back to console log)
RESEND_API_KEY=
EMAIL_FROM=Studio <onboarding@resend.dev>
