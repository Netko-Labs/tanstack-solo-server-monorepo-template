# Every variable the studio reads. Copy to .env; the defaults match compose.yml.
# Production refuses to boot without BASE_URL, DATABASE_URL, AUTH_SECRET and RESEND_API_KEY.

# App
# Generate with: openssl rand -base64 32 (production rejects short or placeholder values)
AUTH_SECRET=
BASE_URL=http://localhost:3000
# Dev server and built server port (default 3000); keep BASE_URL in step.
# PORT=3000
# NODE_ENV is set for you: vite dev → development; repo build and the start script → production.
# Pino level; default debug in development, info in production. Tests accept silent.
# LOG_LEVEL=info

# Data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/temp-repo
# Set → RoomBus fans out over Redis pub/sub (multi-instance). Empty → in-process bus.
CACHE_URL=redis://localhost:6379
# Host ports for compose.yml's Postgres and Redis; change together with DATABASE_URL / CACHE_URL.
# STUDIO_DB_PORT=5432
# STUDIO_REDIS_PORT=6379

# Edge
# Extra browser origins trusted by better-auth, /api/trpc and the /trpc-ws upgrade
# (BASE_URL is always trusted)
TRUSTED_ORIGINS=
# Proxy IPs/CIDRs in front of the app (e.g. a CDN before Traefik), so auth rate limits key on the
# real client IP. Empty → only single-value forwarded headers are trusted.
TRUSTED_PROXIES=

# Auth providers (magic link is always on; a provider turns on when both values are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email
# Required in production. Empty in development → the magic link is logged to the dev console.
RESEND_API_KEY=
EMAIL_FROM=Studio <onboarding@resend.dev>

# Observability → code-whiskers (all optional; unset = off; docs/observability.md)
# The browser bundle bakes in VITE_SENTRY_DSN plus the release and environment at build time.
# SENTRY_DSN=https://<public_key>@whiskers.example.com/<projectId>
# VITE_SENTRY_DSN=https://<public_key>@whiskers.example.com/<projectId>
# OTEL_EXPORTER_OTLP_ENDPOINT=https://whiskers.example.com/otlp
# OTEL_EXPORTER_OTLP_HEADERS=x-codewhiskers-key=<public_key>
# OTEL_SERVICE_NAME=studio
# Default: production when NODE_ENV=production, else development. Staging must set it.
# SENTRY_ENVIRONMENT=staging
# Default: SOURCE_COMMIT (Coolify sets it), else dev.
# SENTRY_RELEASE=
